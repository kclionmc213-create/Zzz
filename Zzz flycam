--========================================================
-- FIND BOMB
--========================================================

local function getBombTarget()

	local origin =
		Camera.CFrame.Position

	local direction =
		Camera.CFrame.LookVector * 1500

	local params =
		RaycastParams.new()

	params.FilterType =
		Enum.RaycastFilterType.Exclude

	params.FilterDescendantsInstances = {
		LP.Character
	}

	local result =
		workspace:Raycast(
			origin,
			direction,
			params
		)

	if not result then
		return nil
	end

	local obj = result.Instance

	for _ = 1,8 do

		if not obj then
			break
		end

		local name =
			string.lower(obj.Name)

		if string.find(name,"bomb")
			or string.find(name,"bom") then

			if obj:IsA("BasePart") then
				return obj
			end

			local p =
				obj:FindFirstChildWhichIsA(
					"BasePart",
					true
				)

			if p then
				return p
			end
		end

		obj = obj.Parent
	end

	return nil
end

--========================================================
-- PHYSICS
--========================================================

local attachment
local velocity
local orientation

local function clearPhysics()

	if velocity then
		velocity:Destroy()
		velocity = nil
	end

	if orientation then
		orientation:Destroy()
		orientation = nil
	end

	if attachment then
		attachment:Destroy()
		attachment = nil
	end
end

local function setupPhysics(part)

	clearPhysics()

	attachment = Instance.new("Attachment")
	attachment.Parent = part

	velocity = Instance.new("LinearVelocity")
	velocity.Attachment0 = attachment
	velocity.MaxForce = math.huge
	velocity.VectorVelocity = Vector3.zero
	velocity.Parent = part

	orientation = Instance.new("AlignOrientation")
	orientation.Attachment0 = attachment
	orientation.MaxTorque = math.huge
	orientation.Responsiveness = 200
	orientation.Parent = part
end

--========================================================
-- CAMERA
--========================================================

local function readCameraAngles()

	local look =
		Camera.CFrame.LookVector

	yaw =
		math.atan2(
			-look.X,
			-look.Z
		)

	pitch =
		math.asin(
			math.clamp(
				look.Y,
				-1,
				1
			)
		)
end

local function getLookVector()

	return CFrame.fromOrientation(
		pitch,
		yaw,
		0
	).LookVector
end

