local function stopDrone()

	droneActive = false
	bombFlying = false

	forward = false
	backward = false
	left = false
	right = false

	clearPhysics()

	selectedBomb = nil

	hud.Visible = false
	controls.Visible = false

	if droneSound.IsPlaying then
		droneSound:Stop()
	end

	glitch.Visible = false

	Camera.CameraType =
		Enum.CameraType.Custom

	droneButton.Text =
		"🚁 DRONE: TẮT"

	bombButton.Text =
		"💣 CHỌN BOM"

	lastPosition = nil
	flightStart = 0
	maxAltitude = 0
end

--========================================================
-- START
--========================================================

local function startDrone()

	if not selectedBomb then

		selectedBomb =
			getBombTarget()

		if not selectedBomb then

			droneButton.Text =
				"🚁 CHƯA CHỌN BOM"

			task.delay(1,function()

				if not droneActive then
					droneButton.Text =
						"🚁 DRONE: TẮT"
				end

			end)

			return
		end
	end

	readCameraAngles()

	setupPhysics(selectedBomb)

	droneActive = true
	bombFlying = true

	flightStart = os.clock()
	lastPosition = selectedBomb.Position
	maxAltitude = selectedBomb.Position.Y
	lastUpdate = os.clock()

	Camera.CameraType =
		Enum.CameraType.Scriptable

	droneButton.Text =
		"🚁 DRONE: BẬT"

	updateDroneUI()
end

droneButton.Activated:Connect(function()

	if droneActive then
		stopDrone()
	else
		startDrone()
	end

end)

