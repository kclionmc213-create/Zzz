local function playDroneGlitch()

	if glitchRunning then
		return
	end

	if not droneActive then
		return
	end

	glitchRunning = true
	glitch.Visible = true

	local start = os.clock()

	while os.clock() - start < .32
		and droneActive do

		for _,line in ipairs(glitchLines) do

			line.Visible =
				math.random() > .35

			line.Position =
				UDim2.new(
					0,
					math.random(-12,12),
					math.random(),
					0
				)

			line.Size =
				UDim2.new(
					1,
					math.random(-80,80),
					0,
					math.random(1,3)
				)

			line.BackgroundTransparency =
				math.random(35,75)/100
		end

		glitch.BackgroundTransparency =
			math.random(88,96)/100

		task.wait(.025)
	end

	for _,line in ipairs(glitchLines) do
		line.Visible = false
	end

	glitch.BackgroundTransparency = 1
	glitch.Visible = false
	glitchRunning = false
end

