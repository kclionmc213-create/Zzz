local function removeHighlight(character)
	if espHighlights[character] then
		espHighlights[character]:Destroy()
		espHighlights[character] = nil
	end
end

local function applyHighlight(character)
	if not wallhackActive then return end
	if character == LP.Character then return end
	
	if not espHighlights[character] then
		local hl = Instance.new("Highlight")
		hl.Name = "DroneESP"
		hl.FillColor = Color3.fromRGB(255, 50, 50)
		hl.FillTransparency = 0.5
		hl.OutlineColor = Color3.fromRGB(255, 255, 255)
		hl.OutlineTransparency = 0
		hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
		hl.Adornee = character
		hl.Parent = character
		
		espHighlights[character] = hl
	end
end

local function toggleWallhack()
	wallhackActive = not wallhackActive
	
	if wallhackActive then
		wallhackButton.Text = "👁 XUYÊN TƯỜNG: BẬT"
		
		for _, plr in ipairs(Players:GetPlayers()) do
			if plr ~= LP and plr.Character then
				applyHighlight(plr.Character)
			end
		end
	else
		wallhackButton.Text = "👁 XUYÊN TƯỜNG: TẮT"
		
		for char, hl in pairs(espHighlights) do
			hl:Destroy()
		end
		table.clear(espHighlights)
	end
end

wallhackButton.Activated:Connect(toggleWallhack)

