			end
		end

		cameraTouch = input
		lastTouch = pos

	elseif input.UserInputType ==
		Enum.UserInputType.MouseButton2 then

		cameraTouch = input
		lastTouch = input.Position
	end
end)

UIS.InputChanged:Connect(function(input)

	if not droneActive then
		return
	end

	if input == cameraTouch then

		local position =
			input.Position

		local delta =
			position - lastTouch

		lastTouch = position

		yaw -=
			delta.X *
			CAMERA_SENSITIVITY

		pitch -=
			delta.Y *
			CAMERA_SENSITIVITY

		pitch =
			math.clamp(
				pitch,
				math.rad(-85),
				math.rad(85)
			)
	end
end)

UIS.InputEnded:Connect(function(input)

	if input == cameraTouch then

		cameraTouch = nil
		lastTouch = nil

	end
end)

--========================================================
-- KEYBOARD
--========================================================

UIS.InputBegan:Connect(function(input,gp)

	if gp then
		return
	end

	if input.KeyCode == Enum.KeyCode.F then

		if droneActive then
			stopDrone()
		else
			startDrone()
		end

	elseif input.KeyCode == Enum.KeyCode.V then

		THIRD_PERSON =
			not THIRD_PERSON

		cameraButton.Text =
			THIRD_PERSON
			and "🎥 GÓC NHÌN: 3D"
			or "🎥 GÓC NHÌN: FPV"

	elseif input.KeyCode == Enum.KeyCode.X then

		toggleWallhack()

	elseif input.KeyCode == Enum.KeyCode.W then
		forward = true

	elseif input.KeyCode == Enum.KeyCode.S then
		backward = true

	elseif input.KeyCode == Enum.KeyCode.A then
		left = true

	elseif input.KeyCode == Enum.KeyCode.D then
		right = true

	elseif input.KeyCode == Enum.KeyCode.Q then

		SPEED =
			math.max(
				MIN_SPEED,
				SPEED - 50
			)

		updateSpeed()

	elseif input.KeyCode == Enum.KeyCode.E then

		SPEED =
			math.min(
				MAX_SPEED,
				SPEED + 50
			)

		updateSpeed()
	end
end)

UIS.InputEnded:Connect(function(input)

	if input.KeyCode == Enum.KeyCode.W then
		forward = false
	elseif input.KeyCode == Enum.KeyCode.S then
		backward = false
	elseif input.KeyCode == Enum.KeyCode.A then
		left = false
	elseif input.KeyCode == Enum.KeyCode.D then
		right = false
	end
end)

--========================================================
-- MAIN FLIGHT LOOP
--========================================================

RunService.RenderStepped:Connect(function()

	--====================================================
	-- KHÔNG Ở DRONE
	--====================================================

	if not droneActive
		or not bombFlying
		or not selectedBomb then

		hud.Visible = false
		controls.Visible = false

		return
	end

	--====================================================
	-- BOM BỊ MẤT
	--====================================================

	if not selectedBomb.Parent then

		stopDrone()

		return
	end

	updateDroneUI()

	local look =
		getLookVector()

	local cameraCF =
		CFrame.lookAt(
			Vector3.zero,
			look
		)

	local cameraRight =
		cameraCF.RightVector

	--====================================================
	-- HƯỚNG BAY
	--====================================================

	local direction =
		Vector3.zero

	if forward then
		direction += look
	end

	if backward then
		direction -= look
	end

	if left then
		direction -= cameraRight
	end

	if right then
		direction += cameraRight
	end

	if direction.Magnitude > 0 then
		direction =
			direction.Unit
	end

	--====================================================
	-- PHYSICS
	--====================================================

	if velocity then

		velocity.VectorVelocity =
			direction * SPEED
	end

	if orientation
		and direction.Magnitude > 0 then

		orientation.CFrame =
			CFrame.lookAt(
				Vector3.zero,
				direction
			)
	end

	--====================================================
	-- CAMERA
	--====================================================

	Camera.CameraType =
		Enum.CameraType.Scriptable

	if THIRD_PERSON then

		local cameraPosition =
			selectedBomb.Position
			- look * CAMERA_DISTANCE
			+ Vector3.new(0,6,0)

		Camera.CFrame =
			CFrame.lookAt(
				cameraPosition,
				cameraPosition + look
			)

	else

		Camera.CFrame =
			CFrame.lookAt(
				selectedBomb.Position,
				selectedBomb.Position + look
			)
	end

	--====================================================
	-- TELEMETRY
	--====================================================

	local now = os.clock()

	local dt =
		math.max(
			now - lastUpdate,
			0.001
		)

	local position =
		selectedBomb.Position

	local altitude =
		position.Y

	maxAltitude =
		math.max(
			maxAltitude,
			altitude
		)

	local currentSpeed = 0

	if lastPosition then

		currentSpeed =
			(position-lastPosition).Magnitude
			/ dt
	end

	lastPosition = position
	lastUpdate = now

	local airTime =
		now - flightStart

	local heading =
		math.deg(
			math.atan2(
				-look.X,
				-look.Z
			)
		)

	if heading < 0 then
		heading += 360
	end

	local pitchDegrees =
		math.deg(pitch)

	local climb =
		look.Y * SPEED

	local throttle =
		math.clamp(
			direction.Magnitude,
			0,
			1
		) * 100

	--====================================================
	-- HUD UPDATE
	--====================================================

	rollText.Text =
		"[ ROLL: +00° | ACRO ]"

	pitchText.Text =
		string.format(
			"PITCH: %+03d° | CLIMB: %03d S/S",
			math.floor(pitchDegrees),
			math.floor(climb)
		)

	altText.Text =
		string.format(
			"ALT: %04d studs | AIR: %.1fs",
			math.floor(altitude),
			airTime
		)

	maxText.Text =
		string.format(
			"MAX: %04d studs | SPS: %03d S/S",
			math.floor(maxAltitude),
			math.floor(currentSpeed)
		)

	thrText.Text =
		string.format(
			"THR: %03d%% | DIR: %03d°",
			math.floor(throttle),
			math.floor(heading)
		)

	tempText.Text =
		"TEMP: 15°C | THERMAL: OFF"

	--====================================================
	-- PITCH BAR
	--====================================================

	local pitchPercent =
		math.clamp(
			(pitchDegrees + 85) / 170,
			0,
			1
		)

	pitchBarFill.Size =
		UDim2.new(
			pitchPercent,
			0,
			1,
			0
		)

	--====================================================
	-- SPEED BAR
	--====================================================

	local speedPercent =
		math.clamp(
			SPEED / MAX_SPEED,
			0,
			1
		)

	speedFill.Size =
		UDim2.new(
			1,
			0,
			speedPercent,
			0
		)

end)

