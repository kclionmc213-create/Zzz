local tab1Data = {
    {Text = "fly cam free no key", Color = Color3.fromRGB(0, 150, 255), Url = "https://raw.githubusercontent.com/dw9118791-tech/Trinhthiennhan-/refs/heads/main/Trinhthiennhan"},
    {Text = "fling", Color = Color3.fromRGB(150, 0, 255), Url = "https://pastefy.app/ZefhoJDD/raw"},
    {Text = "fling things and people hub", Color = Color3.fromRGB(255, 100, 0), Url = "https://rawscripts.net/raw/Fling-Things-and-People-Arahis-hub-229005"},
    {Text = "FTAP HUB", Color = Color3.fromRGB(40, 180, 90), Url = "https://rawscripts.net/raw/Fling-Things-and-People-FTAP-Hub-79081"}
}

for i, data in ipairs(tab1Data) do
    local btn = Instance.new("TextButton")
    btn.Name = "Button1_" .. i
    btn.Parent = Content1
    btn.BackgroundColor3 = data.Color
    btn.Position = UDim2.new(0, 0, (i - 1) * 0.24, 0)
    btn.Size = UDim2.new(1, 0, 0.20, 0)
    btn.Font = Enum.Font.SourceSansBold
    btn.Text = data.Text
    btn.TextColor3 = Color3.fromRGB(255, 255, 255)
    btn.TextSize = 14
    btn.ZIndex = 2

    local btnCorner = Instance.new("UICorner")
    btnCorner.CornerRadius = UDim.new(0, 6)
    btnCorner.Parent = btn

    btn.MouseButton1Click:Connect(function()
        showThankYouMessage()
        pcall(function()
            loadstring(game:HttpGet(data.Url))()
        end)
    end)
end

