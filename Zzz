-- Hàm hiển thị thông báo "Cảm ơn bạn đã bật" trong 2 giây
local function showThankYouMessage()
    local ThankYouLabel = Instance.new("TextLabel")
    ThankYouLabel.Name = "ThankYouMessage"
    ThankYouLabel.Parent = ScreenGui
    ThankYouLabel.BackgroundTransparency = 1
    ThankYouLabel.Position = UDim2.new(0, 0, 0.4, 0)
    ThankYouLabel.Size = UDim2.new(1, 0, 0, 50)
    ThankYouLabel.Font = Enum.Font.SourceSansBold
    ThankYouLabel.Text = "Cảm ơn bạn đã bật"
    ThankYouLabel.TextColor3 = Color3.fromRGB(255, 215, 0)
    ThankYouLabel.TextSize = 30
    ThankYouLabel.TextStrokeTransparency = 0
    ThankYouLabel.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)

    task.delay(2, function()
        ThankYouLabel:Destroy()
    end)
end

